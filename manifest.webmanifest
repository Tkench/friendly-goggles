{
  "name": "Brick Finder",
  "short_name": "Brick Finder",
  "description": "Track missing pieces for your LEGO sets.",
  "start_url": "./#sets",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f4f6",
